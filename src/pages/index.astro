---
import Site from '../layouts/Site.astro';
import { hasContact, phoneLink, services, workshop } from '../workshop';
---
<Site page="home" title="Bieżnik Garage | Wymiana opon i wulkanizacja" description="Wymiana opon i kół, wyważanie, naprawa przebitych opon oraz kontrola felg. Bieżnik Garage.">
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>Wymiana i&nbsp;naprawa opon</h1>
      <p>Przekładamy całe koła i wymieniamy opony z wyważeniem. Jeśli z opony ucieka powietrze, sprawdzimy oponę, zawór i felgę.</p>
      <div class="actions">
        <a class="button button-primary" href={phoneLink ?? '#oferta'}>{phoneLink ? 'Zadzwoń do warsztatu' : 'Sprawdź zakres usług'}</a>
      </div>
    </div>
    <img class="hero-photo" src="/images/kolo.webp" alt="Mechanik pracujący przy kole samochodu" width="1120" height="840" fetchpriority="high" />
  </section>

  <section class="service-section" id="oferta">
    <div class="wrap service-grid">
      <div class="section-heading">
        <h2>Co robimy</h2>
      </div>
      <ul class="service-list">
        {services.map((service) => (
          <li>
            <a href={`/uslugi.html#${service.id}`}>
              <div><h3>{service.title}</h3><p>{service.summary}</p></div>
              <span class="link-icon" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap visit-grid">
    <img src="/images/montaz.webp" alt="Mechanik w rękawicach trzymający koło przy montażownicy" width="1120" height="840" loading="lazy" decoding="async" />
    <div class="visit-copy">
      <h2>Co zabrać na wymianę?</h2>
      <p>Weź drugi komplet opon lub kół. Jeśli masz śruby zabezpieczające, sprawdź, czy w aucie jest pasująca nasadka. Często leży przy kole zapasowym albo w schowku.</p>
      <a class="text-link" href="/uslugi.html#przed-wizyta">Najczęstsze pytania</a>
    </div>
  </section>

  {hasContact && (
    <section class="contact-section" id="kontakt">
      <div class="wrap contact-inner">
        <h2>Kontakt</h2>
        <address>
          {workshop.address && <div>{workshop.address}</div>}
          {workshop.hours && <div>{workshop.hours}</div>}
          {phoneLink && <a href={phoneLink}>{workshop.phone}</a>}
          {workshop.email && <a href={`mailto:${workshop.email}`}>{workshop.email}</a>}
        </address>
      </div>
    </section>
  )}
</Site>
